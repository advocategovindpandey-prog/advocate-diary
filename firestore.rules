rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function prof(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function hasProf() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me() { return prof(request.auth.uid).data; }
    function isMaster() { return hasProf() && me().role == 'master'; }
    function isAdmin() { return hasProf() && me().role == 'admin'; }
    function activeProfile(p) {
      return p != null && p.status == 'active' &&
        (!('expiresAt' in p) || p.expiresAt == null || p.expiresAt > request.time);
    }
    function live() {
      return hasProf() && (isMaster() || (activeProfile(me()) &&
        (me().role == 'admin' || me().role == 'user') &&
        (me().role == 'user' ? (me().parentId != null && exists(/databases/$(database)/documents/users/$(me().parentId)) && activeProfile(prof(me().parentId).data)) : true)));
    }
    function ownerExists(owner) { return exists(/databases/$(database)/documents/users/$(owner)); }
    function ownerData(owner) { return prof(owner).data; }
    function sameTeam(owner) {
      return live() && ownerExists(owner) && me().role == 'user' &&
        ownerData(owner).role == 'user' && ownerData(owner).parentId == me().parentId;
    }
    function isOwnParent(owner) {
      return live() && me().role == 'user' && owner == me().parentId;
    }
    function canReadData(owner) {
      return live() && ownerExists(owner) && (
        owner == request.auth.uid || isMaster() ||
        (isAdmin() && ownerData(owner).parentId == request.auth.uid) ||
        sameTeam(owner) || isOwnParent(owner));
    }
    function canWriteData(owner) {
      return live() && ownerExists(owner) && (
        owner == request.auth.uid || isMaster() ||
        (isAdmin() && ownerData(owner).parentId == request.auth.uid) ||
        sameTeam(owner) ||
        (isOwnParent(owner) && (me().canEditMaster == true || (me().perms is map && (me().perms.edit == true || me().perms.date == true)))));
    }
    function validActor() {
      return request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.updatedByRole == me().role &&
        (request.resource.data.updatedByName == me().name || request.resource.data.updatedByName == me().email);
    }

    match /users/{uid} {
      allow get, list: if hasProf() && (
        uid == request.auth.uid || isMaster() || (me().role == 'user' && uid == me().parentId) ||
        (isAdmin() && resource.data.parentId == request.auth.uid) ||
        (me().role == 'user' && resource.data.role == 'user' && resource.data.parentId == me().parentId) ||
        resource.data.parentId == request.auth.uid);
      allow create: if signedIn() && (
        isMaster() ||
        (isAdmin() && request.resource.data.parentId == request.auth.uid && request.resource.data.role == 'user') ||
        (uid == request.auth.uid && request.resource.data.role in ['admin','user'] && request.resource.data.requestStatus == 'pending'));
      allow update: if hasProf() && (
        isMaster() ||
        (isAdmin() && resource.data.parentId == request.auth.uid && request.resource.data.parentId == resource.data.parentId && request.resource.data.role == resource.data.role) ||
        (uid == request.auth.uid && request.resource.data.role == resource.data.role && request.resource.data.parentId == resource.data.parentId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','mobile','lastLogin','lastLoginAt','emailVerified','updatedAt','deviceCode','activeDevices','fcmToken','photoURL'])));
      allow delete: if isMaster() || (isAdmin() && resource.data.parentId == request.auth.uid);
    }

    match /ids/{id} {
      allow read: if true;
      allow create, update, delete: if live() && (isMaster() || isAdmin());
    }

    match /config/{docId} {
      allow read: if true;
      allow create, update, delete: if live() && isMaster();
    }

    match /userData/{owner} {
      allow read: if canReadData(owner);
      allow create, update: if canWriteData(owner) && validActor();
      allow delete: if isMaster();
      match /chunks/{chunkId} {
        allow read: if canReadData(owner);
        allow create, update, delete: if canWriteData(owner);
      }
    }

    match /notifications/{noteId} {
      allow read: if live() && (isMaster() || resource.data.scope == 'GLOBAL' ||
        resource.data.scope == request.auth.uid || resource.data.scope == me().parentId);
      allow create: if live() && request.resource.data.senderId == request.auth.uid &&
        ((request.resource.data.scope == 'GLOBAL' && isMaster()) || request.resource.data.scope == request.auth.uid ||
         request.resource.data.scope == me().parentId);
      allow update, delete: if live() && (isMaster() || resource.data.senderId == request.auth.uid);
    }

    // Legacy edit requests remain readable for older pending requests. New shared edits
    // are written directly to userData/{owner}/chunks by the HTML apps.
    match /edits/{editId} {
      allow read: if live() && (isMaster() || resource.data.ownerUid == request.auth.uid || resource.data.byUid == request.auth.uid);
      allow create: if live() && request.resource.data.byUid == request.auth.uid &&
        (isMaster() || request.resource.data.ownerUid == request.auth.uid || request.resource.data.ownerUid == me().parentId ||
         (ownerExists(request.resource.data.ownerUid) && ownerData(request.resource.data.ownerUid).parentId == me().parentId));
      allow update: if live() && (isMaster() || resource.data.ownerUid == request.auth.uid);
      allow delete: if live() && (isMaster() || resource.data.ownerUid == request.auth.uid);
    }

    match /teams/{teamId}/cases/{caseId} {
      allow read: if live() && (isMaster() || resource.data.owner == request.auth.uid || resource.data.byUid == request.auth.uid ||
        (isAdmin() && resource.data.owner is string && ownerExists(resource.data.owner) && ownerData(resource.data.owner).parentId == request.auth.uid) ||
        (me().role == 'user' && resource.data.owner is string && ownerExists(resource.data.owner) && ownerData(resource.data.owner).parentId == me().parentId));
      allow create, update: if live() && (isMaster() || request.resource.data.byUid == request.auth.uid || request.resource.data.owner == request.auth.uid);
      allow delete: if live() && (isMaster() || resource.data.byUid == request.auth.uid || resource.data.owner == request.auth.uid);
    }
  }
}
